# Copy to .env and replace placeholders. Never commit .env.

# --- Application ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
PUBLIC_API_URL=http://localhost:8000
# OAuth results redirect here (/oauth/result?status=...). Leave empty to get JSON from the callback.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Security (generate your own values) ---------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated; the first key encrypts, all keys decrypt (rotation).
TOKEN_ENCRYPTION_KEYS=replace-with-a-fernet-key

# --- Infrastructure (docker compose overrides the hosts) -----------------
POSTGRES_USER=email_assistant
POSTGRES_PASSWORD=replace-with-a-db-password
POSTGRES_DB=email_assistant
DATABASE_URL=postgresql+asyncpg://email_assistant:replace-with-a-db-password@localhost:5432/email_assistant
REDIS_URL=redis://localhost:6379/0

# --- Gmail OAuth (Google Cloud Console -> OAuth client, type "Web application") ---
# Authorized redirect URI: ${PUBLIC_API_URL}/api/v1/accounts/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Graph OAuth (optional; Azure app registration) -------------
# Redirect URI: ${PUBLIC_API_URL}/api/v1/accounts/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Mock mailbox with sample emails; replies are recorded, never delivered.
SANDBOX_MODE=true

# --- LLM -------------------------------------------------------------------
# "mock" = deterministic heuristics (no key, for dev/tests). "anthropic" = Claude.
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# low | medium | high | xhigh | max (Claude models no longer accept temperature)
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=2
LLM_REFUSAL_FALLBACK=true
LLM_MAX_INPUT_CHARS=16000

# --- Decision thresholds ---------------------------------------------------
EMERGENCY_CONFIDENCE_THRESHOLD=0.75
REVIEW_CONFIDENCE_THRESHOLD=0.55
# Domains whose automated alerts may be emergencies, e.g. pagerduty.com,opsgenie.com
TRUSTED_ALERT_DOMAINS=

# --- Synchronization -------------------------------------------------------
SYNC_INTERVAL_SECONDS=300
INITIAL_SYNC_DAYS=7
INITIAL_SYNC_MAX_MESSAGES=200

# --- Notification channels (optional) --------------------------------------
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Retention (days, 0 = keep forever) ------------------------------------
EMAIL_BODY_RETENTION_DAYS=30
EMAIL_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365
TASK_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90

# --- Observability ---------------------------------------------------------
METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
